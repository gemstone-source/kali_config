{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "color": {
            "1": "#@accent@",
            "2": "#@magenta@",
            "3": "#@cyan@"
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        { "type": "title", "key": "  " },
        { "type": "os" },
        { "type": "kernel" },
        { "type": "uptime" },
        { "type": "packages" },
        { "type": "shell" },
        { "type": "wm" },
        { "type": "terminal" },
        { "type": "cpu" },
        { "type": "gpu" },
        { "type": "memory" },
        { "type": "disk" }
    ]
}
